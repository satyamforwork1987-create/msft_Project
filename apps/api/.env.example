# FinSight AI — Local Development Environment
# Copy this to apps/api/.env and fill in your API keys

# ── AI APIs (required for live AI Boardroom calls) ────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ── Supabase (optional — demo works without it) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Service URLs ───────────────────────────────────────────────────────────────
PORT=8080
ML_SERVICE_URL=http://localhost:8000

# ── Frontend (set in apps/web/.env.local) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
